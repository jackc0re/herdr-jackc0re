{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.16"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "machine-vitals",
          "type": "block",
          "content": {
            "mod": "machine-vitals"
          },
          "size": {
            "px": 100
          }
        },
        {
          "id": "claude-limits",
          "type": "block",
          "content": {
            "mod": "claude-status",
            "props": {
              "part": "limits"
            }
          },
          "size": {
            "px": 80
          }
        },
        {
          "id": "codex-limits",
          "type": "block",
          "content": {
            "mod": "codex-status"
          },
          "size": {
            "px": 80
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "jackc0re-spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "critters"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "wsl",
          "type": "block",
          "content": {
            "mod": "wsl"
          },
          "size": {
            "px": 34
          }
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "jackc0re-tabs"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 10,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files-remote",
                      "type": "block",
                      "content": {
                        "mod": "filetree"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    },
                    {
                      "id": "tab-notes",
                      "type": "block",
                      "content": {
                        "mod": "tab-notes"
                      }
                    },
                    {
                      "id": "blueprint",
                      "type": "block",
                      "content": {
                        "mod": "blueprint",
                        "props": {
                          "panel": true
                        }
                      }
                    }
                  ],
                  "active": "files-remote",
                  "size": {
                    "weight": 7
                  }
                },
                {
                  "id": "claude-session",
                  "type": "block",
                  "content": {
                    "mod": "claude-status",
                    "props": {
                      "part": "session",
                      "block": "claude-session"
                    }
                  },
                  "size": {
                    "weight": 3
                  },
                  "min": 300
                }
              ],
              "size": {
                "px": 300
              },
              "min": 280,
              "max": 900,
              "hidden": true,
              "gap": 8
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "workspace-status"
          },
          "size": {
            "px": 28
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "theme": "jackc0re",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ]
}
